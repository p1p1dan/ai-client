# Dev/test credentials — copy to `dev.env` and fill in your own key.
#
#   cp dev.env.example dev.env
#
# `scripts/dev.js` reads `dev.env` at startup, strips every ANTHROPIC_* /
# Claude credential var inherited from your shell, then injects only what is
# declared here. Without this file `node scripts/dev.js` refuses to start,
# because the app would otherwise fall back to your personal ~/.claude login
# and bill your own account.
#
# `dev.env` is gitignored. Dev only — packaged builds ignore it entirely.

# Gateway base URL. Omit to hit api.anthropic.com directly.
ANTHROPIC_BASE_URL=https://your-gateway.example

# Your key. ANTHROPIC_AUTH_TOKEN is preferred; use ANTHROPIC_API_KEY instead if
# your gateway expects that header. Never set both — a stale API key wins over
# the token in some CLI paths.
ANTHROPIC_AUTH_TOKEN=sk-replace-me
#ANTHROPIC_API_KEY=

# Optional model override for the generated config dir.
#ANTHROPIC_MODEL=

# Optional: extra workspaces to pre-trust, comma-separated. The repo root is
# always trusted. Untrusted workspaces make cli.js park on a first-run prompt.
#AICLIENT_TRUSTED_WORKSPACES=/home/you/projects/other-repo

# Optional: point at your own Claude config dir instead of the generated,
# isolated one. Only set this if you know why you need it.
#CLAUDE_CONFIG_DIR=
