# Dev/test provider credentials — copy to `dev.env` and fill in your own key.
#
#   cp dev.env.example dev.env
#
# `scripts/dev.js` strips credential-shaped variables inherited from the shell,
# then injects only values declared here. Pi consumes these provider settings;
# no legacy agent configuration directory is created or modified.
#
# `dev.env` is gitignored. Packaged builds ignore it entirely.

# Example Anthropic-compatible provider endpoint. Omit for the provider default.
ANTHROPIC_BASE_URL=https://your-gateway.example

# Use the credential shape required by your provider. Never commit real values.
ANTHROPIC_AUTH_TOKEN=sk-replace-me
#ANTHROPIC_API_KEY=

# Optional dev-only credential mode override: 1 = managed, 0 = local Pi config.
#AICLIENT_MANAGED_CREDENTIALS=0

# Optional auth-gate escape hatch for focused local UI work.
#AICLIENT_SKIP_AUTH_GATE=1
