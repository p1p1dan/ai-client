{
  // Type-check gate for what is left of the Agent Host.
  //
  // WHY A SEPARATE CONFIG: the root `tsconfig.json` excludes `src/agent-host/**`
  // (`pnpm typecheck` reports 0 files from this directory), because these files
  // are loaded under Node's `--experimental-strip-types` (the DSH bridge imports
  // them as source in dev) and therefore import their own modules with an
  // explicit `.ts` suffix, which the root config rejects. Run via
  // `pnpm typecheck:agent-host`; both gates are required, neither covers the other.
  //
  // dsh-rebase P1-12 step 3 (decision 147): the native worker, its npm package
  // (`package.json` / `node_modules`) and its throwaway spikes are gone. What
  // remains is the worker RPC server and its errors (the DSH bridge drives
  // them), stderr redaction and the Codex item mapper. Step 4 moves them out
  // and deletes this directory and this gate with it.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Node strips types at runtime, so Host-internal imports carry `.ts`.
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // No DOM: this is a Node process. A stray `window`/`document` reference must
    // fail here rather than survive into the packaged Host.
    "lib": ["ESNext"],
    "types": ["node"]
  },
  // `../shared/**` is deliberately NOT listed: the Host's relative
  // `../shared/types/*.ts` imports pull in exactly the shared modules it uses, and
  // the root gate already checks all of `src/shared` (where the `@shared/*` alias
  // those files use is defined — this config does not declare it).
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
