{
  "name": "@aiclient/dsh-host",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ai-client DSH worker host: dsh-base + @aiclient/dsh-app booted by dsh-app-boot on the bundled Node runtime; packaged as resources/dsh-host.",
  "scripts": {
    "host": "node --expose-internals host.ts",
    "measure": "node tools/measure.ts",
    "bridge-smoke": "node tools/bridge-smoke.ts"
  },
  "dependencies": {
    "@aiclient/dsh-app": "file:./bundle",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2",
    "@deepseek-ai/dsh-base": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.7-rc.2",
    "dsh-office-tools": "1.0.4",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.13"
  },
  "overrides": {
    "dsh-office-tools": {
      "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
      "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
      "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
      "@deepseek-ai/dsh-session": "0.1.7-rc.2",
      "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
