{
  // Type-check gate for the DSH host, its bridge and the probe drivers under
  // tools/ (dsh-rebase plan). CI runs it as `pnpm typecheck:dsh-host`.
  //
  // Separate config (as the retired `src/runtime` had, before dsh-rebase
  // P1-12): this directory is its own npm package with its own `node_modules`
  // (@deepseek-ai/* pinned in `package.json`), so the root gate excludes
  // `src/dsh-host/**`. Run from the repo root after `npm ci` in here:
  //   pnpm exec tsc --noEmit -p src/dsh-host/tsconfig.json
  //
  // P0-3: `bridge/` and `credentials/` import shared types and libraries from
  // `src/shared` as source (bundler resolution, `.ts` extensions). Since
  // dsh-rebase P1-12 step 4 the bridge's RPC server lives in `bridge/` itself
  // and `src/agent-host` is gone. Node strips types at runtime (erasable
  // syntax only), so no emit.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["node"]
  },
  // P1-1: the bridge's unit tests run in the root Vitest and are checked here,
  // next to the code they exercise. P1-2: probe drivers moved to tools/.
  // P1-3a: host.ts's pure rules live in lib/, bundled into host.js.
  // P1-6b: the aiclient-permissions row and its tests.
  // P1-8: the aiclient-loop-guard row and its tests.
  // P1-5b: the aiclient-credentials row and its tests.
  // P1-13c/13d: the aiclient-encrypted-read row and its tests.
  "include": [
    "*.ts",
    "__tests__/*.ts",
    "bridge/*.ts",
    "bridge/__tests__/*.ts",
    "lib/*.ts",
    "lib/__tests__/*.ts",
    "permissions/*.ts",
    "permissions/__tests__/*.ts",
    "loopGuard/*.ts",
    "loopGuard/__tests__/*.ts",
    "credentials/*.ts",
    "credentials/__tests__/*.ts",
    "encryptedRead/*.ts",
    "encryptedRead/__tests__/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": ["node_modules", "bundle", "tools/probe-bundle"]
}
