{
  // Type-check gate for the DSH host, its bridge and the probe drivers under
  // tools/ (dsh-rebase plan). CI runs it as `pnpm typecheck:dsh-host`.
  //
  // Separate config for the same reason as `src/runtime/tsconfig.json`: this
  // directory is its own npm package with its own `node_modules`
  // (@deepseek-ai/* pinned in `package.json`), so the root gate excludes
  // `src/dsh-host/**`. Run from the repo root after `npm ci` in here:
  //   pnpm exec tsc --noEmit -p src/dsh-host/tsconfig.json
  //
  // P0-3: `bridge/` imports the worker RPC server and shared types from
  // `src/agent-host` and `src/shared`, so resolution mirrors
  // `src/agent-host/tsconfig.json` (bundler resolution, `.ts` extensions).
  // Node strips types at runtime (erasable syntax only), so no emit.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["node"]
  },
  // P1-1: the bridge's unit tests run in the root Vitest and are checked here,
  // next to the code they exercise. P1-2: probe drivers moved to tools/.
  "include": ["*.ts", "bridge/*.ts", "bridge/__tests__/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "bundle", "tools/probe-bundle"]
}
