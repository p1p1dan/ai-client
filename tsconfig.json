{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // src/shared modules that the Pi worker loads as SOURCE (dev runs the
    // worker under --experimental-strip-types) must spell out `.ts` on value
    // imports, because Node's ESM resolver does no extension search. Bundling
    // is unaffected: esbuild/vite resolve the suffix directly.
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/**/*", "electron.vite.config.ts"],
  "exclude": ["src/agent-host/**", "node_modules", "out", "dist"]
}
